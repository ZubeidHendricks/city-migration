// 1. Register the custom URL segment provider (in builder section):
builder.Services.AddUnique<IUrlSegmentProvider, CityUrlSegmentProvider>();

// 2. Register the legacy redirect middleware (after builder.Build()):
var app = builder.Build();

// *** ADD THIS LINE — must come before UseUmbraco ***
app.UseMiddleware<LegacyRedirectMiddleware>();

app.UseUmbraco()
    .WithMiddleware(u =>
    {
        u.UseBackOffice();
        u.UseWebsite();
    })
    .WithEndpoints(u =>
    {
        u.UseInstallerEndpoints();
        u.UseBackOfficeEndpoints();
        u.UseWebsiteEndpoints();
    });

