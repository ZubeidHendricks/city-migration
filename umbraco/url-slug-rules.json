        { "sharepoint": "/Departments/Enterprise-and-Investment",               "umbraco": "/departments/enterprise-and-investment" },
        { "sharepoint": "/Departments/Environmental-Management",                "umbraco": "/departments/environmental-management" },
        { "sharepoint": "/Departments/Fire-and-Rescue-Service",                 "umbraco": "/departments/fire-and-rescue-service" },
        { "sharepoint": "/Departments/Human-Resources",                         "umbraco": "/departments/human-resources" },
        { "sharepoint": "/Departments/Law-Enforcement-Traffic-and-Coordination","umbraco": "/departments/law-enforcement-traffic-and-coordination" },
        { "sharepoint": "/Departments/Metropolitan-Police-Services",            "umbraco": "/departments/metropolitan-police-services" },
