{
  "_comment": "SharePoint path → Umbraco slug transformation rules. Applied in order.",

  "globalRules": [
    { "description": "Decode URL encoding (%20 → space, then space → hyphen)", "pattern": "%20", "replace": "-" },
    { "description": "Lowercase everything",                                    "transform": "lowercase" },
    { "description": "Replace spaces with hyphens",                             "pattern": " ",   "replace": "-" },
    { "description": "Remove .aspx extension",                                  "pattern": ".aspx", "replace": "" },
    { "description": "Collapse multiple hyphens",                               "pattern": "--+", "replace": "-", "regex": true },
    { "description": "Strip trailing slash",                                    "transform": "trimTrailingSlash" }
  ],

  "sectionMappings": [
    {
      "sharepoint": "/City-Connect",
      "umbraco":    "/city-connect",
      "children": [
        { "sharepoint": "/City-Connect/Apply",    "umbraco": "/city-connect/apply" },
        { "sharepoint": "/City-Connect/Pay",      "umbraco": "/city-connect/pay" },
        { "sharepoint": "/City-Connect/Register", "umbraco": "/city-connect/register" },
        { "sharepoint": "/City-Connect/Report",   "umbraco": "/city-connect/report" },
        { "sharepoint": "/City-Connect/have-your-say", "umbraco": "/city-connect/have-your-say" }
      ]
    },
    {
      "sharepoint": "/Departments",
      "umbraco":    "/departments",
      "children": [
        { "sharepoint": "/Departments/Budget-Office",                           "umbraco": "/departments/budget-office" },
        { "sharepoint": "/Departments/City-Health",                             "umbraco": "/departments/city-health" },
        { "sharepoint": "/Departments/Community-Arts-and-Culture",              "umbraco": "/departments/community-arts-and-culture" },
        { "sharepoint": "/Departments/Customer-Relations",                      "umbraco": "/departments/customer-relations" },
        { "sharepoint": "/Departments/Development-Management",                  "umbraco": "/departments/development-management" },
        { "sharepoint": "/Departments/Disaster-Risk-Management",                "umbraco": "/departments/disaster-risk-management" },
